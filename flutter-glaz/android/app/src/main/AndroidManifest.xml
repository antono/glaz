<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bluetooth to the glasses (flutter_blue_plus README). Scanning is not
         used to find location, so Android 12+ needs no location permission. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Bluetooth scanning needs it up to Android 11; the Location service
         needs it on every version, so it has no maxSdkVersion. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Photos go to the shared Pictures/Glaz so they outlive the app
         (lib/services/photo_dir.dart). Writing there needs nothing from
         Android 11 on; before it, the storage permissions below. Reading
         back the photos of an earlier install needs READ_MEDIA_IMAGES, its
         recordings in Recordings/Glaz READ_MEDIA_AUDIO. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- The Internet service fetches pages for apps on the glasses. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Transcripts (Speech.kt): ML Kit's recognizer will not run without
         it, though the sound comes from the glasses, not the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Pairing the Flipper through the Companion Device Manager
         (Companion.kt); the app still runs on phones without it. -->
    <uses-feature android:name="android.software.companion_device_setup"
        android:required="false" />
    <!-- The Flipper wakes glaz (FlipperPresence.kt) and the link service
         keeps it running in the background (LinkService.kt). -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- The link service's notification, asked for on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="Glaz"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Reads the phone's notifications for the glasses, once the user
             allows it in the system settings (notification_listener_service). -->
        <service
            android:label="Glaz"
            android:name="notification.listener.service.NotificationListener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- The keyboard remote while Glaz is in the background, once the user
             turns it on in Accessibility (KeyRemoteService.kt). -->
        <service
            android:label="@string/key_remote_label"
            android:name=".KeyRemoteService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_remote" />
        </service>
        <!-- Bound by Android while the paired Flipper is near: wakes glaz
             (FlipperPresence.kt, Companion.kt's observe). -->
        <service
            android:label="Glaz"
            android:name=".FlipperPresence"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>
        <!-- Holds the Flipper's and the glasses' links in the background,
             with the "Glaz" notification (LinkService.kt). -->
        <service
            android:name=".LinkService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Voice.kt: the assistant's answers read aloud, in headphones -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
